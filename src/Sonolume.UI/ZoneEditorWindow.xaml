<Window x:Class="Sonolume.UI.ZoneEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zone Editor" Width="980" Height="620" MinWidth="760" MinHeight="420"
        Background="#1B1B20" Foreground="#E6E6EA" FontFamily="Segoe UI" FontSize="12"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Project" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="ProjectNameBox" Grid.Column="1" VerticalAlignment="Center"
                     LostFocus="ProjectNameBox_Commit" KeyDown="ProjectNameBox_KeyDown" />
            <Button Grid.Column="2" Content="New" Margin="12,0,0,0" Padding="10,3" Click="New_Click" />
            <Button Grid.Column="3" Content="Open..." Margin="8,0,0,0" Padding="10,3" Click="Open_Click" />
            <Button Grid.Column="4" Content="Save As..." Margin="8,0,0,0" Padding="10,3" Click="SaveAs_Click" />
            <Button x:Name="UndoButton" Grid.Column="5" Content="Undo" Margin="16,0,0,0" Padding="10,3" Click="Undo_Click" />
            <Button x:Name="RedoButton" Grid.Column="6" Content="Redo" Margin="8,0,0,0" Padding="10,3" Click="Redo_Click" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
                    <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="0,0,0,4">
                        <TextBlock Text="Zones" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                            <Button Content="+" Width="24" Margin="4,0,0,0" Click="AddZone_Click" />
                            <Button Content="-" Width="24" Margin="4,0,0,0" Click="RemoveZone_Click" />
                        </StackPanel>
                    </DockPanel>
                    <ListBox x:Name="ZoneList" DisplayMemberPath="Name" SelectionChanged="ZoneList_SelectionChanged" />
                </DockPanel>

                <DockPanel Grid.Row="1" LastChildFill="True">
                    <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="0,0,0,4">
                        <TextBlock Text="Groups" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                            <Button Content="+" Width="24" Margin="4,0,0,0" Click="AddGroup_Click" />
                            <Button Content="-" Width="24" Margin="4,0,0,0" Click="RemoveGroup_Click" />
                        </StackPanel>
                    </DockPanel>
                    <ListBox x:Name="GroupList" DisplayMemberPath="Name" SelectionChanged="GroupList_SelectionChanged" />
                </DockPanel>
            </Grid>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,0,0,0">
                    <StackPanel x:Name="ZonePanel" Visibility="Collapsed">
                        <TextBlock Text="Zone" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />

                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Name" Width="70" VerticalAlignment="Center" />
                            <TextBox x:Name="ZoneNameBox" LostFocus="ZoneField_Commit" KeyDown="ZoneField_KeyDown" />
                        </DockPanel>

                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Group" Width="70" VerticalAlignment="Center" />
                            <ComboBox x:Name="ZoneGroupCombo" DisplayMemberPath="Name" SelectionChanged="ZoneGroupCombo_SelectionChanged" />
                        </DockPanel>

                        <TextBlock Text="Rect: X, Y, W, H (0..1)" Margin="0,6,0,4" Foreground="#9A9AA3" />
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ZoneXBox" Grid.Column="0" ToolTip="X" LostFocus="ZoneField_Commit" KeyDown="ZoneField_KeyDown" />
                            <TextBox x:Name="ZoneYBox" Grid.Column="2" ToolTip="Y" LostFocus="ZoneField_Commit" KeyDown="ZoneField_KeyDown" />
                            <TextBox x:Name="ZoneWBox" Grid.Column="4" ToolTip="W" LostFocus="ZoneField_Commit" KeyDown="ZoneField_KeyDown" />
                            <TextBox x:Name="ZoneHBox" Grid.Column="6" ToolTip="H" LostFocus="ZoneField_Commit" KeyDown="ZoneField_KeyDown" />
                        </Grid>

                        <TextBlock Text="Cell grid: columns, rows" Margin="0,6,0,4" Foreground="#9A9AA3" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ZoneCellsWBox" Grid.Column="0" LostFocus="ZoneField_Commit" KeyDown="ZoneField_KeyDown" />
                            <TextBox x:Name="ZoneCellsHBox" Grid.Column="2" LostFocus="ZoneField_Commit" KeyDown="ZoneField_KeyDown" />
                        </Grid>

                        <TextBlock Text="Params (live, not undoable)" FontWeight="SemiBold" Margin="0,4,0,6" />
                        <StackPanel x:Name="ZoneParamsPanel" />
                    </StackPanel>

                    <StackPanel x:Name="GroupPanel" Visibility="Collapsed">
                        <TextBlock Text="Group" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />

                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Name" Width="70" VerticalAlignment="Center" />
                            <TextBox x:Name="GroupNameBox" LostFocus="GroupField_Commit" KeyDown="GroupField_KeyDown" />
                        </DockPanel>

                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="Parent" Width="70" VerticalAlignment="Center" />
                            <ComboBox x:Name="GroupParentCombo" DisplayMemberPath="Name" SelectionChanged="GroupParentCombo_SelectionChanged" />
                        </DockPanel>

                        <TextBlock Text="Params (live, not undoable)" FontWeight="SemiBold" Margin="0,4,0,6" />
                        <StackPanel x:Name="GroupParamsPanel" />
                    </StackPanel>

                    <StackPanel x:Name="EmptyPanel">
                        <TextBlock Text="Select a zone or group to edit, or add a new one." Foreground="#9A9AA3" />
                        <TextBlock Text="Tip: you can also drag a zone to move it, or drag its handles to resize it, directly on the live preview." Foreground="#9A9AA3" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
