<UserControl x:Class="Sonolume.UI.SonolumeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Sonolume.UI"
             Background="#1B1B20"
             Foreground="#E6E6EA"
             FontFamily="Segoe UI"
             FontSize="12"
             MinWidth="820" MinHeight="560"
             PreviewKeyDown="SonolumeView_PreviewKeyDown">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
            <TextBlock Text="Sonolume" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" DockPanel.Dock="Left" />
            <TextBox x:Name="ProjectNameBox" DockPanel.Dock="Left" Width="150" Margin="10,0,0,0" VerticalAlignment="Center"
                     LostFocus="ProjectNameBox_Commit" KeyDown="ProjectNameBox_KeyDown" />
            <TextBlock x:Name="StatusText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#9A9AA3" TextAlignment="Right" />
            <Button x:Name="RedoButton" DockPanel.Dock="Right" Content="Redo" Margin="8,0,0,0" Padding="10,3" Click="Redo_Click" />
            <Button x:Name="UndoButton" DockPanel.Dock="Right" Content="Undo" Margin="8,0,0,0" Padding="10,3" Click="Undo_Click" />
            <Button DockPanel.Dock="Right" Content="Save As..." Margin="8,0,0,0" Padding="10,3" Click="SaveAs_Click" />
            <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="Save" Margin="16,0,0,0" Padding="10,3" Click="Save_Click" />
            <Button DockPanel.Dock="Right" Content="Open..." Margin="8,0,0,0" Padding="10,3" Click="Open_Click" />
            <Button DockPanel.Dock="Right" Content="New" Margin="8,0,0,0" Padding="10,3" Click="New_Click" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="10" />
                <RowDefinition Height="240" />
            </Grid.RowDefinitions>

            <local:PreviewControl x:Name="Preview" Grid.Row="0" Grid.Column="0" />

            <!-- Bottom menu: zones/groups list (left) and the selected item's Name/Group/Rect/Cell grid (right) -->
            <Border Grid.Row="2" Grid.Column="0" Background="#24242B" CornerRadius="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                <TextBlock Text="Zones" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                    <Button Content="+" Width="24" Margin="4,0,0,0" Click="AddZone_Click" />
                                    <Button Content="-" Width="24" Margin="4,0,0,0" Click="RemoveZone_Click" />
                                </StackPanel>
                            </DockPanel>
                            <ListBox x:Name="ZoneList" DisplayMemberPath="Name" MaxHeight="150" Margin="0,0,0,10" SelectionChanged="ZoneList_SelectionChanged" />

                            <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                <TextBlock Text="Groups" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                    <Button Content="+" Width="24" Margin="4,0,0,0" Click="AddGroup_Click" />
                                    <Button Content="-" Width="24" Margin="4,0,0,0" Click="RemoveGroup_Click" />
                                </StackPanel>
                            </DockPanel>
                            <ListBox x:Name="GroupList" DisplayMemberPath="Name" MaxHeight="150" SelectionChanged="GroupList_SelectionChanged" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <StackPanel x:Name="ZoneFieldsPanel" Visibility="Collapsed">
                                <TextBlock Text="Zone" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />

                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="Name" Width="70" VerticalAlignment="Center" />
                                    <TextBox x:Name="ZoneNameBox" LostFocus="ZoneField_Commit" KeyDown="ZoneField_KeyDown" />
                                </DockPanel>

                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="Group" Width="70" VerticalAlignment="Center" />
                                    <ComboBox x:Name="ZoneGroupCombo" DisplayMemberPath="Name" SelectionChanged="ZoneGroupCombo_SelectionChanged" />
                                </DockPanel>

                                <TextBlock Text="Rect: X, Y, W, H (0..1)" Margin="0,6,0,4" Foreground="#9A9AA3" />
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ZoneXBox" Grid.Column="0" ToolTip="X" LostFocus="ZoneField_Commit" KeyDown="ZoneField_KeyDown" />
                                    <TextBox x:Name="ZoneYBox" Grid.Column="2" ToolTip="Y" LostFocus="ZoneField_Commit" KeyDown="ZoneField_KeyDown" />
                                    <TextBox x:Name="ZoneWBox" Grid.Column="4" ToolTip="W" LostFocus="ZoneField_Commit" KeyDown="ZoneField_KeyDown" />
                                    <TextBox x:Name="ZoneHBox" Grid.Column="6" ToolTip="H" LostFocus="ZoneField_Commit" KeyDown="ZoneField_KeyDown" />
                                </Grid>

                                <TextBlock Text="Cell grid: columns, rows" Margin="0,6,0,4" Foreground="#9A9AA3" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ZoneCellsWBox" Grid.Column="0" LostFocus="ZoneField_Commit" KeyDown="ZoneField_KeyDown" />
                                    <TextBox x:Name="ZoneCellsHBox" Grid.Column="2" LostFocus="ZoneField_Commit" KeyDown="ZoneField_KeyDown" />
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="GroupFieldsPanel" Visibility="Collapsed">
                                <TextBlock Text="Group" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />

                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="Name" Width="70" VerticalAlignment="Center" />
                                    <TextBox x:Name="GroupNameBox" LostFocus="GroupField_Commit" KeyDown="GroupField_KeyDown" />
                                </DockPanel>

                                <DockPanel>
                                    <TextBlock Text="Parent" Width="70" VerticalAlignment="Center" />
                                    <ComboBox x:Name="GroupParentCombo" DisplayMemberPath="Name" SelectionChanged="GroupParentCombo_SelectionChanged" />
                                </DockPanel>
                            </StackPanel>

                            <StackPanel x:Name="EmptyFieldsPanel">
                                <TextBlock Text="Select a zone or group to edit, or add a new one." Foreground="#9A9AA3" TextWrapping="Wrap" />
                                <TextBlock Text="Tip: you can also drag a zone to move it, or drag its handles to resize it, directly on the live preview." Foreground="#9A9AA3" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- Right menu: all params for the selected zone/group -->
            <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" Background="#24242B" CornerRadius="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock x:Name="ParamsTitle" Text="Params" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <TextBlock x:Name="ParamsEmptyText" Text="Select a zone or group to edit its parameters." Foreground="#9A9AA3" TextWrapping="Wrap" />
                        <StackPanel x:Name="ParamsPanel" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Decay" VerticalAlignment="Center" />
            <Slider x:Name="DecaySlider" Grid.Column="1" Margin="10,0" Minimum="0.02" Maximum="2" Value="0.25"
                    VerticalAlignment="Center" ValueChanged="DecaySlider_ValueChanged" />
            <TextBlock x:Name="DecayText" Grid.Column="2" Width="60" VerticalAlignment="Center" Text="250 ms" />
            <TextBlock x:Name="MidiText" Grid.Column="3" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#9A9AA3" Text="MIDI: 0 events" />
        </Grid>
    </Grid>
</UserControl>
