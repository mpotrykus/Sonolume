<UserControl x:Class="Sonolume.UI.SonolumeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Sonolume.UI"
             Background="#1B1B20"
             Foreground="#E6E6EA"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             FontSize="12"
             MinWidth="820" MinHeight="560"
             PreviewKeyDown="SonolumeView_PreviewKeyDown">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <DockPanel LastChildFill="False">
                <Path DockPanel.Dock="Left" Width="20" Height="21.2" Stretch="Uniform" VerticalAlignment="Center"
                      Fill="{StaticResource AccentBrush}"
                      Data="M92.618,95.09l50.21-15.587L92.391,65.562l13.422-23.409L85.775,53.097L71.377,0L54.854,56.3l-17.408-9.7
                            l10.014,19.41L0,79.504l45.102,14.402l-8.541,17.497l17.969-9.302l16.845,48.969l15.339-48.261l14.653,7.71L92.618,95.09z
                            M70.999,119.236L60.35,88.277l-25.737-8.219l25.847-7.349l10.537-35.903l9.737,35.909l26.572,7.344l-26.467,8.216L70.999,119.236z">
                    <Path.Effect>
                        <DropShadowEffect Color="{StaticResource AccentColor}" Opacity="0.8" BlurRadius="10" ShadowDepth="0" />
                    </Path.Effect>
                </Path>
                <TextBlock Text="Sonolume" Style="{StaticResource TitleTextStyle}" VerticalAlignment="Center" Margin="10,0,0,0" DockPanel.Dock="Left" />

                <Button x:Name="MenuButton" DockPanel.Dock="Right" Style="{StaticResource PlainIconButtonStyle}" Click="MenuButton_Click" ToolTip="Menu">
                    <TextBlock Text="&#xE700;" Style="{StaticResource IconGlyphStyle}" />
                    <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource AppContextMenuStyle}">
                            <MenuItem Header="New" Style="{StaticResource AppMenuItemStyle}" Click="New_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE7C3;" Style="{StaticResource IconGlyphStyle}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Open..." Style="{StaticResource AppMenuItemStyle}" Click="Open_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE8B7;" Style="{StaticResource IconGlyphStyle}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="OpenRecentMenuItem" Header="Open Recent" Style="{StaticResource AppMenuItemStyle}" SubmenuOpened="OpenRecentMenuItem_SubmenuOpened">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE81C;" Style="{StaticResource IconGlyphStyle}" />
                                </MenuItem.Icon>
                                <MenuItem Header="(placeholder, populated on open)" />
                            </MenuItem>
                            <MenuItem x:Name="SaveMenuItem" Header="Save" Style="{StaticResource AppMenuItemStyle}" Click="Save_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE74E;" Style="{StaticResource IconGlyphStyle}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Save As..." Style="{StaticResource AppMenuItemStyle}" Click="SaveAs_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE792;" Style="{StaticResource IconGlyphStyle}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator Style="{StaticResource AppMenuSeparatorStyle}" />
                            <MenuItem x:Name="ImportSignalRgbMenuItem" Header="Import from SignalRGB" Style="{StaticResource AppMenuItemStyle}" Click="ImportSignalRgb_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE896;" Style="{StaticResource IconGlyphStyle}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="ManualSignalRgbImportMenuItem" Header="Manual Import" Style="{StaticResource AppMenuItemStyle}" Click="ManualSignalRgbImport_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE70F;" Style="{StaticResource IconGlyphStyle}" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Border DockPanel.Dock="Right" Style="{StaticResource VerticalDividerStyle}" />

                <Button x:Name="RedoButton" DockPanel.Dock="Right" Style="{StaticResource PlainIconButtonStyle}" Margin="6,0,0,0" Click="Redo_Click" ToolTip="Redo">
                    <TextBlock Text="&#xE7A6;" Style="{StaticResource IconGlyphStyle}" />
                </Button>
                <Button x:Name="UndoButton" DockPanel.Dock="Right" Style="{StaticResource PlainIconButtonStyle}" Click="Undo_Click" ToolTip="Undo">
                    <TextBlock Text="&#xE7A7;" Style="{StaticResource IconGlyphStyle}" />
                </Button>
            </DockPanel>
            <Border Style="{StaticResource HorizontalDividerStyle}" Margin="0,16,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="180" MaxWidth="400" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="300" MinWidth="350" MaxWidth="600" />
            </Grid.ColumnDefinitions>

            <!-- Left column: zones/groups list -->
            <Border x:Name="LeftPanelBorder" Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBox x:Name="ProjectNameBox" Margin="0,0,0,20"
                                 LostFocus="ProjectNameBox_Commit" KeyDown="ProjectNameBox_KeyDown" />

                        <DockPanel LastChildFill="True" Margin="0,0,0,6">
                            <TextBlock Text="Zones" Style="{StaticResource SectionHeaderTextStyle}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                <Button Content="&#xE710;" Style="{StaticResource IconButtonStyle}" Click="AddZone_Click" ToolTip="Add zone" />
                                <Button x:Name="RemoveZoneButton" Content="&#xE738;" Margin="6,0,0,0" Style="{StaticResource IconButtonStyle}" Click="RemoveZone_Click" ToolTip="Remove zone" IsEnabled="False" />
                            </StackPanel>
                        </DockPanel>
                        <ListBox x:Name="ZoneList" MaxHeight="240" Margin="0,0,0,20" SelectionChanged="ZoneList_SelectionChanged"
                                 AllowDrop="True" PreviewMouseLeftButtonDown="ZoneList_PreviewMouseLeftButtonDown" PreviewMouseMove="ZoneList_PreviewMouseMove"
                                 DragOver="ZoneList_DragOver" Drop="ZoneList_Drop">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#xE700;" FontFamily="{StaticResource IconFontFamily}" FontSize="12"
                                                   Foreground="{StaticResource MutedForegroundBrush}" Margin="0,0,8,0"
                                                   VerticalAlignment="Center" Cursor="SizeAll" ToolTip="Drag to reorder" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding KeyLabel}" Foreground="{StaticResource KeyLabelBrush}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <DockPanel LastChildFill="True" Margin="0,0,0,6">
                            <TextBlock Text="Groups" Style="{StaticResource SectionHeaderTextStyle}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                <Button Content="&#xE710;" Style="{StaticResource IconButtonStyle}" Click="AddGroup_Click" ToolTip="Add group" />
                                <Button x:Name="RemoveGroupButton" Content="&#xE738;" Margin="6,0,0,0" Style="{StaticResource IconButtonStyle}" Click="RemoveGroup_Click" ToolTip="Remove group" IsEnabled="False" />
                            </StackPanel>
                        </DockPanel>
                        <ListBox x:Name="GroupList" MaxHeight="240" SelectionChanged="GroupList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding KeyLabel}" Foreground="{StaticResource KeyLabelBrush}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1" Style="{StaticResource ColumnSplitterStyle}" />

            <Border x:Name="CenterPanelBorder" Grid.Column="2" Style="{StaticResource PanelBorderStyle}" Padding="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <local:PreviewControl x:Name="Preview" Grid.Row="0" />

                    <StackPanel Grid.Row="1" Margin="0,4,0,0">
                        <Border x:Name="KeyboardHeader" Style="{StaticResource CollapsibleHeaderBorderStyle}" Background="Transparent" Margin="-8,0,-4,-4"
                                Cursor="Hand" MouseLeftButtonUp="KeyboardHeader_MouseLeftButtonUp">
                            <DockPanel>
                                <TextBlock x:Name="KeyboardChevron" Text="&#xE70D;" FontFamily="{StaticResource IconFontFamily}" FontSize="10"
                                           VerticalAlignment="Center" Foreground="{StaticResource MutedForegroundBrush}" DockPanel.Dock="Right" Margin="6,0,0,0" />
                                <TextBlock Text="Keyboard" Style="{StaticResource SectionHeaderTextStyle}" />
                                <TextBlock x:Name="KeyboardNoteText" VerticalAlignment="Center" Margin="8,0,6,0" TextAlignment="Right" Foreground="{StaticResource KeyLabelBrush}" />
                            </DockPanel>
                        </Border>
                        <local:VirtualKeyboardControl x:Name="VirtualKeyboard" Height="90" Margin="0,8,0,0" Visibility="Collapsed" />
                        <Grid x:Name="KeyboardOctaveRow" Margin="0,8,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="OctaveDownButton" Grid.Column="0" Content="&#x25C0; Octave" Padding="10,2" Click="OctaveDown_Click" ToolTip="Shift keyboard down an octave" />
                            <TextBlock x:Name="KeyboardRangeText" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" />
                            <Button x:Name="OctaveUpButton" Grid.Column="2" Content="Octave &#x25B6;" Padding="10,2" Click="OctaveUp_Click" ToolTip="Shift keyboard up an octave" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Style="{StaticResource ColumnSplitterStyle}" />

            <!-- Right menu: identity/geometry fields and all params for the selected zone/group -->
            <Border x:Name="RightPanelBorder" Grid.Column="4" Style="{StaticResource PanelBorderStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <StackPanel x:Name="EmptyFieldsPanel">
                            <TextBlock Text="Select or add a zone or group to edit." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ParamsTitle" Grid.Column="0" Text="Params" Style="{StaticResource PanelHeaderTextStyle}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed" />
                            <CheckBox x:Name="ParamsActiveCheckBox" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                      ToolTip="Active" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>

                        <StackPanel x:Name="ZoneIdentityPanel" Visibility="Collapsed">
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Name" Width="72" Style="{StaticResource FieldLabelTextStyle}" />
                                <TextBox x:Name="ZoneNameBox" LostFocus="ZoneField_Commit" KeyDown="ZoneField_KeyDown" />
                            </DockPanel>

                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Group" Width="72" Style="{StaticResource FieldLabelTextStyle}" />
                                <ComboBox x:Name="ZoneGroupCombo" DisplayMemberPath="Name" SelectionChanged="ZoneGroupCombo_SelectionChanged" />
                            </DockPanel>

                            <DockPanel Margin="0,0,0,16">
                                <TextBlock Text="Key" Width="72" Style="{StaticResource FieldLabelTextStyle}" />
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <ComboBox x:Name="ZoneKeyOctaveCombo" Margin="0,0,6,0" SelectionChanged="KeyOctaveCombo_SelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ComboBox x:Name="ZoneChannelCombo" SelectionChanged="ChannelCombo_SelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>

                        <StackPanel x:Name="GroupIdentityPanel" Visibility="Collapsed">
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Name" Width="72" Style="{StaticResource FieldLabelTextStyle}" />
                                <TextBox x:Name="GroupNameBox" LostFocus="GroupField_Commit" KeyDown="GroupField_KeyDown" />
                            </DockPanel>

                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Parent" Width="72" Style="{StaticResource FieldLabelTextStyle}" />
                                <ComboBox x:Name="GroupParentCombo" DisplayMemberPath="Name" SelectionChanged="GroupParentCombo_SelectionChanged" />
                            </DockPanel>

                            <DockPanel Margin="0,0,0,16">
                                <TextBlock Text="Key" Width="72" Style="{StaticResource FieldLabelTextStyle}" />
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <ComboBox x:Name="GroupKeyOctaveCombo" Margin="0,0,6,0" SelectionChanged="KeyOctaveCombo_SelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ComboBox x:Name="GroupChannelCombo" SelectionChanged="ChannelCombo_SelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>

                        <Border x:Name="ZoneGeometryBorder" Visibility="Collapsed" Style="{StaticResource GroupBorderStyle}" Margin="0,12,0,0" Padding="12">
                            <StackPanel>
                                <Border x:Name="ZoneGeometryHeader" Style="{StaticResource CollapsibleHeaderBorderStyle}" Margin="-12,-12,-12,-12"
                                        CornerRadius="8,8,6,6"
                                        Cursor="Hand" MouseLeftButtonUp="ZoneGeometryHeader_MouseLeftButtonUp">
                                    <DockPanel>
                                        <TextBlock x:Name="ZoneGeometryChevron" Text="&#xE70D;" FontFamily="{StaticResource IconFontFamily}" FontSize="10"
                                                   VerticalAlignment="Center" Foreground="{StaticResource MutedForegroundBrush}" DockPanel.Dock="Right" Margin="6,0,0,0" />
                                        <TextBlock Text="&#xE7C2;" FontFamily="{StaticResource IconFontFamily}" FontSize="13"
                                                   VerticalAlignment="Center" Foreground="{StaticResource MutedForegroundBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="Transform" Style="{StaticResource SectionHeaderTextStyle}" />
                                    </DockPanel>
                                </Border>
                                <StackPanel x:Name="ZoneGeometryContent" Margin="0,8,0,8">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <ToggleButton x:Name="ZoneInvertXToggle" Content="&#x21C4;" Style="{StaticResource ToggleIconButtonStyle}"
                                                      ToolTip="Invert X Axis" Checked="ZoneInvertToggle_Changed" Unchecked="ZoneInvertToggle_Changed" />
                                        <ToggleButton x:Name="ZoneInvertYToggle" Content="&#x21C5;" Style="{StaticResource ToggleIconButtonStyle}" Margin="6,0,0,0"
                                                      ToolTip="Invert Y Axis" Checked="ZoneInvertToggle_Changed" Unchecked="ZoneInvertToggle_Changed" />
                                    </StackPanel>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Position" Style="{StaticResource FieldLabelTextStyle}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="x" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBox x:Name="ZoneXBox" Grid.Row="0" Grid.Column="2" ToolTip="X" LostFocus="ZoneField_Commit" KeyDown="ZoneField_KeyDown" />
                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="%" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                        <TextBlock Grid.Row="0" Grid.Column="5" Text="y" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBox x:Name="ZoneYBox" Grid.Row="0" Grid.Column="6" ToolTip="Y" LostFocus="ZoneField_Commit" KeyDown="ZoneField_KeyDown" />
                                        <TextBlock Grid.Row="0" Grid.Column="7" Text="%" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="4,0,0,0" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Rotation" Style="{StaticResource FieldLabelTextStyle}" Margin="0,8,0,0" />
                                        <TextBox x:Name="ZoneRotationBox" Grid.Row="1" Grid.Column="2" ToolTip="Clockwise rotation, in degrees" Margin="0,8,0,0" LostFocus="ZoneField_Commit" KeyDown="ZoneField_KeyDown" />
                                        <TextBlock Grid.Row="1" Grid.Column="3" Text="°" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="4,8,0,0" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Size" Style="{StaticResource FieldLabelTextStyle}" Margin="0,8,0,0" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="w" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="0,8,4,0" />
                                        <TextBox x:Name="ZoneWBox" Grid.Row="2" Grid.Column="2" ToolTip="W" Margin="0,8,0,0" LostFocus="ZoneField_Commit" KeyDown="ZoneField_KeyDown" />
                                        <TextBlock Grid.Row="2" Grid.Column="3" Text="%" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="4,8,0,0" />
                                        <TextBlock Grid.Row="2" Grid.Column="5" Text="h" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="0,8,4,0" />
                                        <TextBox x:Name="ZoneHBox" Grid.Row="2" Grid.Column="6" ToolTip="H" Margin="0,8,0,0" LostFocus="ZoneField_Commit" KeyDown="ZoneField_KeyDown" />
                                        <TextBlock Grid.Row="2" Grid.Column="7" Text="%" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="4,8,0,0" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Grid" Style="{StaticResource FieldLabelTextStyle}" Margin="0,8,0,0" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="x" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="0,8,4,0" />
                                        <TextBox x:Name="ZoneCellsWBox" Grid.Row="3" Grid.Column="2" Margin="0,8,0,0" LostFocus="ZoneField_Commit" KeyDown="ZoneField_KeyDown" />
                                        <TextBlock Grid.Row="3" Grid.Column="5" Text="y" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="0,8,4,0" />
                                        <TextBox x:Name="ZoneCellsHBox" Grid.Row="3" Grid.Column="6" Margin="0,8,0,0" LostFocus="ZoneField_Commit" KeyDown="ZoneField_KeyDown" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="ParamsPanel" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,20,0,0">
            <Border Style="{StaticResource HorizontalDividerStyle}" Margin="0,0,0,12" />
            <DockPanel LastChildFill="False">
                <Border DockPanel.Dock="Right" Background="{StaticResource InputBackgroundBrush}" BorderBrush="{StaticResource InputBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="10,4">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel x:Name="SignalRgbStatusPanel" Orientation="Horizontal" VerticalAlignment="Center" ToolTipService.InitialShowDelay="200">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center"
                                     Stroke="{StaticResource InputBorderBrush}" StrokeThickness="1" Fill="Transparent" />
                            <TextBlock Text="SignalRGB" Margin="6,0,0,0" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                        <Border Width="1" Margin="10,1" Background="{StaticResource InputBorderBrush}" />
                        <TextBlock x:Name="StatusMsText" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </StackPanel>
    </Grid>
</UserControl>
