<UserControl x:Class="Sonolume.UI.SonolumeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Sonolume.UI"
             Background="#1B1B20"
             Foreground="#E6E6EA"
             FontFamily="Segoe UI"
             FontSize="12"
             MinWidth="480" MinHeight="300">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True">
            <TextBlock Text="Sonolume" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock x:Name="ProjectNameText" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#9A9AA3" />
            <Button DockPanel.Dock="Right" Content="Edit Zones..." Padding="10,3" Margin="10,0,0,0" Click="EditZones_Click" />
            <TextBlock x:Name="StatusText" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#9A9AA3" TextAlignment="Right" Margin="0,0,10,0" />
        </DockPanel>

        <local:PreviewControl x:Name="Preview" Grid.Row="1" Margin="0,10,0,10" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Decay" VerticalAlignment="Center" />
            <Slider x:Name="DecaySlider" Grid.Column="1" Margin="10,0" Minimum="0.02" Maximum="2" Value="0.25"
                    VerticalAlignment="Center" ValueChanged="DecaySlider_ValueChanged" />
            <TextBlock x:Name="DecayText" Grid.Column="2" Width="60" VerticalAlignment="Center" Text="250 ms" />
            <TextBlock x:Name="MidiText" Grid.Column="3" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#9A9AA3" Text="MIDI: 0 events" />
        </Grid>
    </Grid>
</UserControl>
