<Window x:Class="Sonolume.UI.ManualSignalRgbImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="12"
        Foreground="#E6E6EA"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="Backdrop" Background="#99000000" MouseDown="Backdrop_MouseDown">
        <Border Style="{StaticResource PanelBorderStyle}" Width="420" Padding="24"
                HorizontalAlignment="Center" VerticalAlignment="Center" MouseDown="Card_MouseDown">
            <StackPanel>
                <TextBlock Text="Manual Import from SignalRGB" Style="{StaticResource PanelHeaderTextStyle}" />
                <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,16"
                           Text="For a device SignalRGB can't report a single position for (see the Skipped list after an automatic import). Open SignalRGB's Layout tab, select the component, and copy its X/Y/Width/Height/Rotation and the canvas size shown there." />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Name" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBox x:Name="NameBox" Grid.Column="1" Text="SignalRGB Device" />
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Position" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBox x:Name="XBox" Grid.Column="1" ToolTip="X" />
                    <TextBlock Grid.Column="3" Text="Y" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox x:Name="YBox" Grid.Column="4" ToolTip="Y" />
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Size" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBox x:Name="WidthBox" Grid.Column="1" ToolTip="Width" />
                    <TextBlock Grid.Column="3" Text="H" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox x:Name="HeightBox" Grid.Column="4" ToolTip="Height" />
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Rotation °" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBox x:Name="RotationBox" Grid.Column="1" Text="0" ToolTip="Clockwise rotation, in degrees" />
                </Grid>

                <Border Style="{StaticResource HorizontalDividerStyle}" Margin="0,4,0,16" />

                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Canvas Size" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBox x:Name="CanvasWidthBox" Grid.Column="1" ToolTip="Canvas width" />
                    <TextBlock Grid.Column="3" Text="H" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox x:Name="CanvasHeightBox" Grid.Column="4" ToolTip="Canvas height" />
                </Grid>

                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#FF6B6B" Margin="0,10,0,0" Visibility="Collapsed" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button x:Name="CancelButton" Content="Cancel" Padding="16,7" Click="Cancel_Click" />
                    <Button x:Name="AddButton" Content="Add Zone" Style="{StaticResource PrimaryButtonStyle}" Padding="16,7" Margin="10,0,0,0" Click="Add_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
