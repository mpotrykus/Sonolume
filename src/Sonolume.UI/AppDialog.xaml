<Window x:Class="Sonolume.UI.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="12"
        Foreground="#E6E6EA"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="Backdrop" Background="#99000000" MouseDown="Backdrop_MouseDown">
        <Border Style="{StaticResource PanelBorderStyle}" Width="380" Padding="24"
                HorizontalAlignment="Center" VerticalAlignment="Center" MouseDown="Card_MouseDown">
            <StackPanel>
                <TextBlock x:Name="TitleText" Style="{StaticResource PanelHeaderTextStyle}" TextWrapping="Wrap" />
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,20" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="Cancel" Padding="16,7" Click="Cancel_Click" Visibility="Collapsed" />
                    <Button x:Name="ConfirmButton" Content="OK" Style="{StaticResource PrimaryButtonStyle}" Padding="16,7" Margin="10,0,0,0" Click="Confirm_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
