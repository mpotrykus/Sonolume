<Window x:Class="Sonolume.UI.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="12"
        Foreground="#E6E6EA"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="Backdrop" Background="#99000000" MouseDown="Backdrop_MouseDown">
        <Border Style="{StaticResource PanelBorderStyle}" Width="380"
                HorizontalAlignment="Center" VerticalAlignment="Center" MouseDown="Card_MouseDown">
            <StackPanel>
                <Border Style="{StaticResource ModalHeaderBorderStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TitleIcon" Style="{StaticResource ModalHeaderIconStyle}" />
                        <TextBlock x:Name="TitleText" Style="{StaticResource PanelHeaderTextStyle}" Margin="0" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <StackPanel Margin="24">
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,0">
                        <Button x:Name="CancelButton" Content="Cancel" Padding="16,7" Click="Cancel_Click" Visibility="Collapsed" />
                        <Button x:Name="ConfirmButton" Content="OK" Style="{StaticResource PrimaryButtonStyle}" Padding="16,7" Margin="10,0,0,0" Click="Confirm_Click" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
