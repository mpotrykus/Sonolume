<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- The AudioPlugSharp bridge is copied as "<AssemblyName>Bridge.vst3" and loads "<AssemblyName>.dll". -->
    <AssemblyName>Sonolume</AssemblyName>
    <RootNamespace>Sonolume.Plugin</RootNamespace>
    <Description>Sonolume VST3 plugin shell (AudioPlugSharp).</Description>
    <GenerateDependencyFile>true</GenerateDependencyFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AudioPlugSharp" Version="0.7.13" />
    <PackageReference Include="AudioPlugSharpVst3" Version="0.7.13" />
    <PackageReference Include="AudioPlugSharpWPF" Version="0.7.13" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Sonolume.Engine\Sonolume.Engine.csproj" />
    <ProjectReference Include="..\Sonolume.Persist\Sonolume.Persist.csproj" />
    <ProjectReference Include="..\Sonolume.Transport\Sonolume.Transport.csproj" />
    <ProjectReference Include="..\Sonolume.UI\Sonolume.UI.csproj" />
  </ItemGroup>
</Project>
