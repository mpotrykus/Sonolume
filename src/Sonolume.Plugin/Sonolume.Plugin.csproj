<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- The AudioPlugSharp bridge is copied as "<AssemblyName>Bridge.vst3" and loads "<AssemblyName>.dll". -->
    <AssemblyName>Sonolume</AssemblyName>
    <RootNamespace>Sonolume.Plugin</RootNamespace>
    <Description>Sonolume VST3 plugin shell (AudioPlugSharp).</Description>
    <GenerateDependencyFile>true</GenerateDependencyFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AudioPlugSharp" Version="0.7.13" />
    <PackageReference Include="AudioPlugSharpVst3" Version="0.7.13" />
    <PackageReference Include="AudioPlugSharpWPF" Version="0.7.13" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Sonolume.Engine\Sonolume.Engine.csproj" />
    <ProjectReference Include="..\Sonolume.Persist\Sonolume.Persist.csproj" />
    <ProjectReference Include="..\Sonolume.Transport\Sonolume.Transport.csproj" />
    <ProjectReference Include="..\Sonolume.UI\Sonolume.UI.csproj" />
  </ItemGroup>

  <!--
    AudioPlugSharpWPF 0.7.13's package has no build/*.targets copy step (unlike AudioPlugSharp and
    AudioPlugSharpVst3, which ship one), and the SDK treats this externally-resolved reference as
    Private=false, so AudioPlugSharpWPF.dll never lands in the output directory on its own. The plugin
    loads via a native VST3 bridge (not `dotnet exec`), so there is no dev-time NuGet-cache probing
    fallback at load time - the DLL must physically sit next to Sonolume.dll.
  -->
  <Target Name="CopyAudioPlugSharpWPF" AfterTargets="Build;Publish">
    <ItemGroup>
      <_AudioPlugSharpWPFAsset Include="$(PkgAudioPlugSharpWPF)\lib\net10.0-windows7.0\AudioPlugSharpWPF.dll" />
    </ItemGroup>
    <Error Text="AudioPlugSharpWPF.dll not found at %(_AudioPlugSharpWPFAsset.Identity) - check the installed package version." Condition="!Exists('%(_AudioPlugSharpWPFAsset.Identity)')" />
    <Copy SourceFiles="@(_AudioPlugSharpWPFAsset)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
