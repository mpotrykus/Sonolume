<Window x:Class="Sonolume.Standalone.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sonolume" Width="1180" Height="720" MinWidth="860" MinHeight="620"
        Background="#1B1B20" Foreground="#E6E6EA" FontFamily="Segoe UI" FontSize="12">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#24242B" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="MIDI input" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="DeviceCombo" Grid.Column="1" MinWidth="240" SelectionChanged="DeviceCombo_SelectionChanged" />
                <Button Grid.Column="2" Content="Refresh" Margin="8,0,0,0" Padding="10,3" Click="Refresh_Click" />
            </Grid>
        </Border>
        <ContentControl x:Name="ViewHost" />
    </DockPanel>
</Window>
