<Window x:Class="Sonolume.Standalone.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sonolume" Width="1180" Height="720" MinWidth="860" MinHeight="620"
        Background="#1B1B20" Foreground="#E6E6EA" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBackgroundGradientBrush}" Padding="18,12"
                BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="MIDI input" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,12,0" />
                <ComboBox x:Name="DeviceCombo" Grid.Column="1" MinWidth="260" SelectionChanged="DeviceCombo_SelectionChanged" />
                <Button Grid.Column="2" Margin="8,0,0,0" Click="Refresh_Click" ToolTip="Refresh devices">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource IconGlyphStyle}" />
                        <TextBlock Text="Refresh" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
        <ContentControl x:Name="ViewHost" />
    </DockPanel>
</Window>
